# .env.example — modelo das variáveis de ambiente do projeto.
#
# Este arquivo vai para o GitHub e lista SÓ os NOMES das variáveis, nunca os valores.
# Para rodar o projeto no seu Mac, copie este arquivo para um novo chamado .env.local
# e preencha os valores reais lá. O .env.local é ignorado pelo Git e nunca é enviado.

# Supabase — pegue em Settings > Data API no painel do seu projeto Supabase.
# São seguras para colocar no código (rodam no navegador), mas mesmo assim
# ficam só no .env.local / nas variáveis de ambiente da Vercel, nunca "hardcoded".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
